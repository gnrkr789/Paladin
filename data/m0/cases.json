            {
              "version": "< 3.0.6",
              "status": "affected"
            }
          ]
        }
      ],
      "description_evidence": "Werkzeug is a Web Server Gateway Interface web application library. On Python < 3.11 on Windows, os.path.isabs() does not catch UNC paths like //server/share. Werkzeug's safe_join() relies on this check, and so can produce a path that is not safe, potentially allowing unintended access to data. Applications using Python >= 3.11, or not using Windows, are not vulnerable. Werkzeug version 3.0.6 contains a patch.",
      "cause": "A Windows absolute-path predicate misses a UNC-like path on older Python.",
      "preconditions": [
        "Windows, Python <3.11, Werkzeug <3.0.6, untrusted safe_join path."
      ],
      "prevention": "Reject leading slash paths in addition to existing absolute and parent checks.",
      "patch_alignment": "aligned",
      "alignment_note": "Do not report this CVE on all platforms solely because safe_join is called.",
      "verification_status": "candidate",
      "rule_enabled": false,
      "poc_status": "not_found_in_selected_index",
      "poc_candidates": [],
      "upstream_tests": {
        "status": "source_observed_not_run",
        "locations": [
          "tests/test_security.py::test_safe_join"
        ]
      },
      "planned_checks": {
        "vulnerable": "UNC-like absolute input is rejected.",
        "safe": "Ordinary relative child path remains accepted.",
        "status": "specification_only"
      },
