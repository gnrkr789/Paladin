    {
      "cve_id": "CVE-2024-11168",
      "record_state": "PUBLISHED",
      "family": "ssrf",
      "component": "CPython urllib.parse bracketed hosts",
      "scope": "python_web_backend",
      "version_status": "source_claims_not_normalized",
      "raw_affected": [
        {
          "defaultStatus": "unaffected",
          "product": "CPython",
          "repo": "https://github.com/python/cpython",
          "vendor": "Python Software Foundation",
          "versions": [
            {
              "version": "0",
              "lessThan": "3.9.21",
              "status": "affected",
              "versionType": "python"
            },
            {
              "version": "3.10.0",
              "lessThan": "3.10.16",
              "status": "affected",
              "versionType": "python"
            },
            {
              "version": "3.11.0",
              "lessThan": "3.11.4",
              "status": "affected",
              "versionType": "python"
            },
            {
              "version": "3.12.0a1",
              "lessThan": "3.12.0b1",
              "status": "affected",
              "versionType": "python"
            }
          ]
        }
      ],
      "description_evidence": "The urllib.parse.urlsplit() and urlparse() functions improperly validated bracketed hosts (`[]`), allowing hosts that weren't IPv6 or IPvFuture. This behavior was not conformant to RFC 3986 and potentially enabled SSRF if a URL is processed by more than one URL parser.",
      "cause": "Bracketed non-IP hosts can be interpreted inconsistently by URL parsers.",
      "preconditions": [
        "Untrusted URL reaches multiple parsers with inconsistent host handling; SSRF is conditional."
      ],
      "prevention": "Validate bracketed hosts as IPv6/IPvFuture and use consistent validated destinations at request time.",
      "patch_alignment": "aligned",
      "alignment_note": "Parser fix alone is not a complete network egress policy; redirects and destination controls remain application concerns.",
