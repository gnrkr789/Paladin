    "id": "CVE-2024-49766",
    "sources": [
      {
        "kind": "cve",
        "url": "https://raw.githubusercontent.com/CVEProject/cvelistV5/main/cves/2024/49xxx/CVE-2024-49766.json",
        "path": "data/m0/sources/CVE-2024-49766.cve.json",
        "sha256": "aeeb34927397e676158de94a65f101941d06ff48dc94c0e8c9d75326a9d5dde2",
        "retrieved_on": "2026-10-23",
        "status": "fetched"
      },
      {
        "kind": "poc_index",
        "url": "https://raw.githubusercontent.com/nomi-sec/PoC-in-GitHub/master/2024/CVE-2024-49766.json",
        "status": "unavailable",
        "error": "HTTP Error 404: Not Found"
      }
    ],
    "state": "PUBLISHED",
    "description": [
      {
        "lang": "en",
        "value": "Werkzeug is a Web Server Gateway Interface web application library. On Python < 3.11 on Windows, os.path.isabs() does not catch UNC paths like //server/share. Werkzeug's safe_join() relies on this check, and so can produce a path that is not safe, potentially allowing unintended access to data. Applications using Python >= 3.11, or not using Windows, are not vulnerable. Werkzeug version 3.0.6 contains a patch."
      }
    ],
    "affected": [
      {
        "vendor": "pallets",
        "product": "werkzeug",
        "versions": [
          {
            "version": "< 3.0.6",
            "status": "affected"
          }
        ]
      }
    ],
    "references": [
