{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paladin:m0-corpus:0.1.0",
  "title": "Paladin M0 evidence corpus (local only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "milestone", "created_on", "stack", "agent", "cases"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "milestone": {"const": "M0"},
    "created_on": {"type": "string", "format": "date"},
    "stack": {"const": "python_web_backend"},
    "agent": {"const": "Codex"},
    "cases": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "texts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "url", "path", "sha256", "retrieved_on", "status", "redistribution"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["cve", "poc_index", "patch", "advisory", "changelog", "release_diff"]},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "path": {"$ref": "#/$defs/text"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "retrieved_on": {"type": "string", "format": "date"},
        "status": {"const": "fetched"},
        "redistribution": {"const": "not_assessed"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cve_id", "record_state", "family", "component", "scope", "version_status", "raw_affected", "description_evidence", "cause", "preconditions", "prevention", "patch_alignment", "alignment_note", "verification_status", "rule_enabled", "poc_status", "poc_candidates", "upstream_tests", "planned_checks", "evidence", "patch_anchor", "contribution"],
      "properties": {
        "cve_id": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"},
        "record_state": {"enum": ["PUBLISHED", "REJECTED", "RESERVED"]},
        "family": {"enum": ["path_traversal", "sql_injection", "ssrf", "command_injection", "unsafe_deserialization"]},
        "component": {"$ref": "#/$defs/text"},
        "scope": {"const": "python_web_backend"},
        "version_status": {"const": "source_claims_not_normalized"},
        "raw_affected": {"type": "array", "items": {"type": "object"}},
        "description_evidence": {"$ref": "#/$defs/text"},
        "cause": {"$ref": "#/$defs/text"},
        "preconditions": {"$ref": "#/$defs/texts"},
        "prevention": {"$ref": "#/$defs/text"},
        "patch_alignment": {"enum": ["aligned", "mismatch", "unresolved"]},
        "alignment_note": {"$ref": "#/$defs/text"},
        "verification_status": {"enum": ["candidate", "reviewed", "rule_tested", "reproduced"]},
        "rule_enabled": {"type": "boolean"},
        "review": {
          "type": "object", "additionalProperties": false,
          "required": ["reviewer", "method", "reviewed_on"],
          "properties": {
            "reviewer": {"$ref": "#/$defs/text"}, "method": {"$ref": "#/$defs/text"},
            "reviewed_on": {"type": "string", "format": "date"}
          }
        },
        "poc_status": {"enum": ["index_candidate_found", "not_found_in_selected_index"]},
        "poc_candidates": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["url", "status"],
            "properties": {"url": {"type": "string", "format": "uri", "pattern": "^https://"}, "status": {"const": "unverified_link"}}
          }
        },
        "upstream_tests": {
          "type": "object", "additionalProperties": false, "required": ["status", "locations"],
          "properties": {
            "status": {"enum": ["source_observed_not_run", "not_found_in_selected_patch"]},
            "locations": {"type": "array", "items": {"$ref": "#/$defs/text"}}
          }
        },
        "planned_checks": {
          "type": "object", "additionalProperties": false, "required": ["vulnerable", "safe", "status"],
          "properties": {
            "vulnerable": {"$ref": "#/$defs/text"}, "safe": {"$ref": "#/$defs/text"},
            "status": {"const": "specification_only"}
          }
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "patch_anchor": {
          "type": "object", "additionalProperties": false, "required": ["evidence_id", "start_line", "end_line"],
          "properties": {
            "evidence_id": {"$ref": "#/$defs/text"},
            "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}
          }
        },
        "contribution": {
          "type": "object", "additionalProperties": false, "required": ["sharing_enabled", "scope", "consent_record"],
          "properties": {"sharing_enabled": {"const": false}, "scope": {"const": "local_only"}, "consent_record": {"type": "null"}}
        }
      }
    }
  }
}
